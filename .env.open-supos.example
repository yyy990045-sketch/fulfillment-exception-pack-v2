# Open supOS runtime verification template. Leave values blank in git.
OPEN_SUPOS_ENABLED=true

OPEN_SUPOS_MQTT_URL=
OPEN_SUPOS_MQTT_USERNAME=
OPEN_SUPOS_MQTT_PASSWORD=
OPEN_SUPOS_MQTT_CLIENT_ID_SUBSCRIBER=
OPEN_SUPOS_MQTT_CLIENT_ID_PUBLISHER=

OPEN_SUPOS_UPSTREAM_COMMIT=
OPEN_SUPOS_RUNTIME_CONFIRMED=false
OPEN_SUPOS_VERIFY_TIMEOUT_MS=60000
PACK_STORE_DB=

# Optional discovery results. Use only values verified against the running runtime.
OPEN_SUPOS_API_URL=
OPEN_SUPOS_API_KEY=
OPEN_SUPOS_UPSTREAM_PATCH_REQUIRED=false

# 以下三项是 `npm run open-supos:verify` 的运行时证据闸门。留空 => 对应检查 BLOCKED，
# 闸门整体不会 PASS（缺证据不算通过）。只在真实运行时存在时填写实际地址。
# open supOS 网关健康入口，例如 http://<ENTRANCE_DOMAIN>:8088/health
OPEN_SUPOS_RUNTIME_HEALTH_URL=
# 核心组件健康探针，逗号分隔 name=url
OPEN_SUPOS_COMPONENT_HEALTH=
# open supOS 侧可查询 UNS 数据的入口（namespace/对象查询），用于证明数据真的进了 UNS
OPEN_SUPOS_UNS_VERIFY_URL=
# 是否在闸门里附带分析投影检查（需要指向已经吃过 open supOS 数据的业务库）
OPEN_SUPOS_PROJECTION_VERIFY=false
OPEN_SUPOS_EXPECTED_EXCEPTIONS=4
