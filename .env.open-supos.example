# Open supOS runtime verification template. Leave values blank in git.
OPEN_SUPOS_ENABLED=true

OPEN_SUPOS_MQTT_URL=
OPEN_SUPOS_MQTT_USERNAME=
OPEN_SUPOS_MQTT_PASSWORD=
OPEN_SUPOS_MQTT_CLIENT_ID_SUBSCRIBER=
OPEN_SUPOS_MQTT_CLIENT_ID_PUBLISHER=

OPEN_SUPOS_UPSTREAM_COMMIT=
OPEN_SUPOS_RUNTIME_CONFIRMED=false
OPEN_SUPOS_VERIFY_TIMEOUT_MS=60000
PACK_STORE_DB=

# Optional discovery results. Use only values verified against the running runtime.
OPEN_SUPOS_API_URL=
OPEN_SUPOS_API_KEY=
OPEN_SUPOS_UPSTREAM_PATCH_REQUIRED=false
