{
  "name": "fulfillment-exception-pack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "琶洲参赛 Solution Pack：制造业销售履约例外调查。复用 OpenELab/qa-system/Tongyue 的契约语义，不提交既有源码。",
  "scripts": {
    "test": "vitest run",
    "eval": "tsx src/eval/cli.ts",
    "demo": "tsx src/server.ts",
    "seed:v2-demo": "tsx src/domain/v2/provision-demo.ts",
    "seed:v2-manufacturing": "tsx src/domain/v2/provision-manufacturing.ts",
    "open-supos:inbound": "tsx src/integrations/open-supos/run-inbound.ts",
    "open-supos:verify": "tsx src/integrations/open-supos/runtime-verify.ts",
    "grounded-ai:verify": "tsx src/ai/grounded/verify-real-provider.ts",
    "demo:manufacturing:prepare": "tsx src/workbench/manufacturing/prepare-demo.ts",
    "demo:manufacturing": "npm run demo:manufacturing:prepare && npm run demo",
    "demo:operations:prepare": "tsx src/demo/operational-analytics/prepare-demo.ts",
    "demo:operations": "npm run demo:operations:prepare && npm run demo",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "mqtt": "^5.16.0",
    "openai": "7.18.0"
  }
}
