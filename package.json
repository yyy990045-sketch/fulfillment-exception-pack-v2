{
  "name": "fulfillment-exception-pack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "琶洲参赛 Solution Pack：制造业销售履约例外调查。复用 OpenELab/qa-system/Tongyue 的契约语义，不提交既有源码。",
  "scripts": {
    "test": "vitest run",
    "eval": "tsx src/eval/cli.ts",
    "demo": "tsx src/server.ts",
    "seed:v2-demo": "tsx src/domain/v2/provision-demo.ts",
    "seed:v2-manufacturing": "tsx src/domain/v2/provision-manufacturing.ts",
    "open-supos:inbound": "tsx src/integrations/open-supos/run-inbound.ts",
    "open-supos:verify": "tsx src/integrations/open-supos/runtime-verify.ts",
    "grounded-ai:verify": "tsx src/ai/grounded/verify-real-provider.ts",
    "decision-ai:verify": "tsx src/ai/decision/verify-real-provider.ts",
    "root-cause-ai:verify": "tsx src/ai/root-cause/verify-real-provider.ts",
    "demo:manufacturing:prepare": "tsx src/workbench/manufacturing/prepare-demo.ts",
    "demo:manufacturing": "npm run demo:manufacturing:prepare && npm run demo",
    "demo:operations:prepare": "tsx src/demo/operational-analytics/prepare-demo.ts",
    "demo:operations": "npm run demo:operations:prepare && npm run demo",
    "demo:outcomes:prepare": "tsx src/demo/outcomes/prepare-demo.ts",
    "demo:finance:prepare": "tsx src/demo/solution-packs/prepare-finance.ts",
    "demo:packs:prepare": "tsx src/demo/solution-packs/prepare-all.ts",
    "connector:worker": "tsx src/connectors/run-worker.ts",
    "decision-runtime:benchmark": "tsx src/intelligence/benchmark/cli.ts benchmark",
    "decision-runtime:benchmark-v2": "tsx src/intelligence/benchmark/cli.ts benchmark-v2",
    "decision-runtime:verify-openai": "tsx src/intelligence/benchmark/cli.ts verify-openai",
    "decision-runtime:verify-jev": "tsx src/intelligence/benchmark/cli.ts verify-jev",
    "frontend:dev": "vite --config frontend/vite.config.ts",
    "frontend:build": "vite build --config frontend/vite.config.ts",
    "frontend:test": "vitest run --config frontend/vitest.config.ts",
    "frontend:e2e": "playwright test --config frontend/playwright.config.ts",
    "frontend:openapi": "openapi-typescript contracts/openapi.yaml -o frontend/src/api/schema.d.ts",
    "typecheck": "tsc --noEmit && tsc -p frontend/tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsdom": "^30.1.0",
    "openapi-typescript": "^7.13.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.1",
    "lucide-react": "^0.468.0",
    "mqtt": "^5.16.0",
    "openai": "7.18.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^3.25.76"
  }
}
