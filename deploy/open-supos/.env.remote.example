# open supOS 远程运行时验收配置模板。
# 只允许变量名；真实值写到同目录的 .env.remote（已被 .gitignore 的 `.env.*` 忽略）。
# 不要提交任何真实 credential / token / cookie。

# --- open supOS 运行时入口 ---
OPEN_SUPOS_BASE_URL=
OPEN_SUPOS_UNS_NAMESPACE=
OPEN_SUPOS_TOPIC_PREFIX=
OPEN_SUPOS_PRODUCT_TENANT_ID=
OPEN_SUPOS_INSTALLATION_ID=

# --- MQTT（open supOS EMQX）---
OPEN_SUPOS_MQTT_HOST=
OPEN_SUPOS_MQTT_PORT=
OPEN_SUPOS_MQTT_USERNAME=
OPEN_SUPOS_MQTT_PASSWORD=
# 可选：直接给出完整 URL（默认由 HOST/PORT 拼装）
OPEN_SUPOS_MQTT_URL=

# --- 业务后端（FEP）---
FEP_BASE_URL=
FEP_AUTH_TOKEN=

# --- 运行时证据闸门（npm run open-supos:verify -- --mode live）---
OPEN_SUPOS_ENABLED=true
OPEN_SUPOS_RUNTIME_HEALTH_URL=
OPEN_SUPOS_COMPONENT_HEALTH=
OPEN_SUPOS_UNS_VERIFY_URL=
OPEN_SUPOS_UPSTREAM_COMMIT=
OPEN_SUPOS_RUNTIME_CONFIRMED=false
OPEN_SUPOS_VERIFY_TIMEOUT_MS=60000
OPEN_SUPOS_PROJECTION_VERIFY=true
OPEN_SUPOS_EXPECTED_EXCEPTIONS=1
OPEN_SUPOS_SUPERSET_RECEIPT=

# --- Superset 观察链路（非 secret 配置）---
SUPERSET_DOMAIN=
SUPERSET_DASHBOARD_ID=
SUPERSET_PRODUCT_TENANT_ID=
SUPERSET_SERVICE_USERNAME=
SUPERSET_SERVICE_PASSWORD=
OPEN_SUPOS_SUPERSET_RELOAD=true
POSTGRES_USER=superset
