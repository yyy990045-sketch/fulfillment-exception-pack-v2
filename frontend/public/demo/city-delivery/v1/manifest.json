  "source": {
    "dataType": "synthetic",
    "name": "Synthetic Mechanism Case · 一仓四店配载与卸货",
    "description": "本项目构造的机制演示场景，不是传化真实订单、药店现场数据或公开基准结果。",
    "license": "project-owned-synthetic",
    "authorization": "本次任务授权构造并在项目内使用；不含第三方数据，外部分发由项目 Owner 决定。",
    "publicBenchmarkUsed": false,
    "enterpriseDataUsed": false
  },
  "dataType": "synthetic",
  "coordinateSystem": {
    "units": "m",
    "origin": "车厢前壁左下角",
    "position": "minimum-corner",
    "x": "车厢宽度方向",
    "y": "竖直向上",
    "z": "前壁到后门方向",
    "lengthAxis": "z",
    "widthAxis": "x",
    "heightAxis": "y",
    "rotation": "rotation 为绕 y 轴的角度，单位 degrees；禁止俯仰或侧翻。"
  },
  "files": {
    "scenario": "scenario.json",
    "plans": "plans.json",
    "placements": "placements.json",
    "unloadingSteps": "unloading-steps.json",
    "comparison": "comparison.json"
  },
  "capabilities": {
    "selectVehicle": {
      "supported": true,
      "availableVehicleIds": [
        "V01"
      ]
    },
    "selectPlan": {
      "supported": true,
      "availablePlanIds": [
        "PLAN_A",
        "PLAN_B"
      ]
    },
    "showRoute": true,
    "selectCargo": true,
    "showCargoGeometry": true,
    "playLoadingSteps": true,
    "playUnloadingSteps": true,
    "showBlockedCargo": true,
    "recheckFrozenPlan": true,
    "arbitraryDragAndSolve": false,
    "liveOptimization": false,
    "multiVehicleDispatch": false,
    "extraHandling": false
  },
  "validation": {
    "method": "executed-deterministic-geometry-route-and-unloading-checks",
    "generator": "tools/city-delivery/build_demo.py",
    "allDeclaredConstraintsChecked": true,
    "checkedConstraints": [
      "boundary",
      "collision",
      "weight",
      "orientation",
      "fragile",
      "support",
      "loadBearing",
      "rearDoorUnloading",
      "timeWindow"
    ],
    "uncheckedConstraints": [
      "轴荷与车辆重心",
      "车辆行驶稳定性及货物绑扎",
      "装卸工具及人员活动空间",
      "冷链与品类隔离",
      "真实交通和司机工时",
      "任意旋转或侧门取货",
      "全局最优性"
    ],
    "globallyOptimal": false
  },
  "frontend": {
    "basePath": "/demo/city-delivery/v1/",
    "joinKeys": [
      "scenarioId",
      "planId",
      "vehicleId",
      "stopId",
      "cargoId"
    ],
    "positionField": "placements.json -> plans[].positions[]",
    "renderGeometry": "positions.width/height/length 已为旋转后的 x/y/z 尺寸；以最小角点加半尺寸取中心。不要再次交换尺寸或旋转轴向包围盒。rotation 记录原始货箱绕 y 轴朝向。",
    "unloadingField": "unloading-steps.json -> plans[].stations[] and plans[].steps[]",
    "comparisonField": "comparison.json -> plans[], delta, changes",
    "playbackClockIsTelemetry": false
  },
