# 复制为 .env 后填入本机值。.env 已被 .gitignore 忽略，禁止提交真实密码或密钥。
# 生成随机值：openssl rand -hex 32

# 镜像与 metadata 数据库
SUPERSET_TAG=6.1.0
POSTGRES_USER=superset
POSTGRES_PASSWORD=
POSTGRES_DB=superset

# Superset 自身密钥（session 签名与 metadata 加密）；每个环境必须独立
SUPERSET_SECRET_KEY=
# guest token 签名密钥；不要与 SUPERSET_SECRET_KEY 复用
GUEST_TOKEN_JWT_SECRET=
# guest token 有效期（秒），官方默认 300
SUPERSET_GUEST_TOKEN_TTL=300
# guest token 使用的专用 role 名（由 deploy/superset/init/02-embedded-role.py 幂等创建）。
# 不要使用 "Public"（Superset 默认 Public role 无任何权限，嵌入会全量 403），
# 也不要使用 "Gamma" / "Admin"。
SUPERSET_GUEST_ROLE_NAME=EmbeddedGuest

# 管理员账号（初始化脚本使用）
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=
SUPERSET_ADMIN_EMAIL=admin@example.com

# 下面这组是「业务后端」读取的变量，不是 Superset 容器用的，同样不要提交真实值
# Superset 基础地址：后端调用其 REST API，同时作为前端 iframe 的 domain
SUPERSET_DOMAIN=http://127.0.0.1:8088
# 已开启嵌入的 dashboard UUID（Dashboard 页面里的 Embed 设置）
SUPERSET_DASHBOARD_ID=
# 只允许该产品租户换取 guest token（单租户 pilot 的授权边界）
SUPERSET_PRODUCT_TENANT_ID=demo-manufacturing
# 后端调用 Superset 的服务账号，只存在于服务端
SUPERSET_SERVICE_USERNAME=admin
SUPERSET_SERVICE_PASSWORD=
